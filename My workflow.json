      "parameters": {
        "jsCode": "const hoy = new Date();\nhoy.setHours(0, 0, 0, 0);\n\nconst msPorDia = 1000 * 60 * 60 * 24;\n\nreturn items.map(item => {\n  const j = item.json;\n\n  const rawFecha = j.property_fecha_de_vencimiento;\n  const fechaStr = (rawFecha && typeof rawFecha === 'object') ? rawFecha.start : rawFecha;\n\n  const fechaVenc = new Date(fechaStr);\n\n  if (!fechaStr || isNaN(fechaVenc.getTime())) {\n    return {\n      json: {\n        ...j,\n        dias_restantes: null,\n        ventana: null,\n        error_fecha: true\n      }\n    };\n  }\n\n  const diasRestantes = Math.round((fechaVenc - hoy) / msPorDia);\n\n  let ventana = null;\n  if (diasRestantes >= 0 && diasRestantes <= 30) ventana = 30;\n  else if (diasRestantes > 30 && diasRestantes <= 180) ventana = 180;\n\n  return {\n    json: {\n      ...j,\n      dias_restantes: diasRestantes,\n      ventana: ventana,\n      error_fecha: false\n    }\n  };\n});"
      },
