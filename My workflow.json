      "parameters": {
        "jsCode": "return items.map(item => {\n  const original = $('Get many database pages1').item.json;\n  const raw = item.json.text || item.json.output || '';\n  \n  let parsed;\n  let errorIA = false;\n  \n  try {\n    const limpio = raw.replace(/```json|```/g, '').trim();\n    parsed = JSON.parse(limpio);\n  } catch (e) {\n    parsed = { fecha_emision: null, vigencia_meses: null, certificado_confirmado: false };\n    errorIA = true;\n  }\n\n  let nuevaFechaVencimiento = null;\n  \n  if (parsed.certificado_confirmado && parsed.fecha_emision && parsed.vigencia_meses) {\n    const emision = new Date(parsed.fecha_emision);\n    if (!isNaN(emision.getTime())) {\n      emision.setMonth(emision.getMonth() + parsed.vigencia_meses);\n      nuevaFechaVencimiento = emision.toISOString().split('T')[0];\n    } else {\n      errorIA = true;\n    }\n  }\n\n  return {\n    json: {\n      ...original,\n      fecha_emision: parsed.fecha_emision,\n      vigencia_meses: parsed.vigencia_meses,\n      certificado_confirmado: parsed.certificado_confirmado,\n      nueva_fecha_vencimiento: nuevaFechaVencimiento,\n      error_ia: errorIA\n    }\n  };\n});"
      },
